     // FIXME: Update RequestServer to support multiple custom root certificates.
+    if (certificates.is_empty()) {
+        // Fall back to the SSL_CERT_FILE environment variable when no certificate path is explicitly
+        // provided, so that distributions that keep their CA bundle in a non-default location (such
+        // as /var/lib/ca-certificates/ca-bundle.pem or /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem)
+        // can be used.
+        auto ssl_cert_file = Core::Environment::get("SSL_CERT_FILE"sv);
+        if (ssl_cert_file.has_value() && !ssl_cert_file->is_empty())
+            certificates.append(ssl_cert_file->to_byte_string());
+    }
